class Solution {
    public int nextGreaterElement(int n) {
        ArrayList<Integer> digit=new ArrayList<>();
        int temp=n;
        while(temp>0){
            int di=temp%10;
            digit.add(di);
            temp=temp/10;
        }
        Collections.reverse(digit);
        int nn=digit.size();
        int[] nums=new int[nn];
        for(int i=0;i<nn;i++){
            nums[i]=digit.get(i);
        }
       
        int br=-1;
        for(int i=nn-1;i>=1;i--){
            if(nums[i-1]<nums[i]){
                br=i-1;
                break;
            }
        }
        if(br==-1){
            return -1;
        }
        
        for(int i=nn-1;i>br;i--){
            if(nums[i]>nums[br]){
                int tem=nums[i];
                nums[i]=nums[br];
                nums[br]=tem;
                break;
            }
        }
        reverse(br+1,nn-1,nums);
        long ans=0;
        for(int i=0;i<nn;i++){
            ans=ans*10+nums[i];
        }
        return (ans > Integer.MAX_VALUE) ? -1 : (int) ans;
        
    }
     public void reverse(int i,int j,int[] nums){
        while(i<j){
            int temp=nums[i];
            nums[i]=nums[j];
            nums[j]=temp;
            i++;
            j--;
        }
    }
}


