class Solution {
    public int nextGreaterElement(int n) {
        String s = String.valueOf(n);
        char[] arr = s.toCharArray();
        int len = arr.length;
        int idx=-1;
        for(int i=len-1;i>=1;i--){
            if(arr[i-1]<arr[i]){
                  idx=i-1;
                  break;
            }
        }
        if(idx==-1){
            return -1;
        }
        
        for(int i=len-1;i>idx;i--){
                   if(arr[idx]<arr[i]){
                            char temp=arr[idx];
                            arr[idx]=arr[i];
                            arr[i]=temp;
                            break;
                   }
                  
        }
        int i=idx+1;
        int j=len-1;
        while(i<j){
            char temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            i++;
            j--;

        }
        String a =new String(arr); 
        long ans = Long.parseLong(a);
        if(ans>Integer.MAX_VALUE){
            return -1;
        }
        return (int) ans;
    }
}
