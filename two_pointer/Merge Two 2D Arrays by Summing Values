class Solution {
    public int[][] modifiedMatrix(int[][] matrix) {
        int n=matrix.length;
        int m=matrix[0].length;
        
        for(int i=0;i<m;i++){
            List<Integer> ind =new ArrayList<>();
            int maxi=-2;
            for(int j=0;j<n;j++){
                if(matrix[j][i]==-1){
                    ind.add(j);
                }
                maxi=Math.max(matrix[j][i],maxi);
               
            }
            for(int idx:ind){
                matrix[idx][i]=maxi;
            }
        }
        return  matrix;
        
    }
}
