class Solution {
    public void nextPermutation(int[] nums) {
        int n=nums.length;
       
        int br=-1;
        for(int i=n-1;i>=1;i--){
            if(nums[i-1]<nums[i]){
                br=i-1;
                break;
            }
        }
        if(br==-1){
            reverse(0,n-1,nums);
            return;
        }
        
        for(int i=n-1;i>br;i--){
            if(nums[i]>nums[br]){
                int temp=nums[i];
                nums[i]=nums[br];
                nums[br]=temp;
                break;
            }
        }
        reverse(br+1,n-1,nums);
        return;

    }
    public void reverse(int i,int j,int[] nums){
        while(i<j){
            int temp=nums[i];
            nums[i]=nums[j];
            nums[j]=temp;
            i++;
            j--;
        }
    }
}


