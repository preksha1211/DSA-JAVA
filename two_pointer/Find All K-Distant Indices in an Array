class Solution {
    public List<Integer> findKDistantIndices(int[] nums, int key, int k) {
        HashSet<Integer> set = new HashSet<>();
        int n=nums.length;
        for(int x=0;x<n;x++){
            if(nums[x]==key){
                int i=x-k;
                int j=x+k;
                print(i,j,nums,set,n);
            }
        }
        List<Integer> ans=new ArrayList<>();
        for(int i=0;i<n;i++){
            if(set.contains(i)){
                  ans.add(i);
            }
           
        }
        return ans;
    }
    public void print(int i,int j,int[] nums,HashSet<Integer> set,int n){
        if(i<0){
            i=0;
        }
        if(j>=n){
            j=n-1;
        }
        for(int k=i;k<=j;k++){
            set.add(k);
        }
    }
}
