class Solution {
    public int[] applyOperations(int[] nums) {
        operations(nums);
        move(nums);
        return nums;
    }
    public void operations(int[] nums){
        for(int i=0;i<nums.length-1;i++){
            if(nums[i]==nums[i+1]){
                nums[i]=nums[i]*2;
                nums[i+1]=0;
            }
        }
    }
    public void move(int[] nums){
       int n=nums.length;
       int i=0;
       for(int j=0;j<n;j++){
          if(nums[j]!=0){
              int temp=nums[i];
              nums[i]=nums[j];
              nums[j]=temp;
              i++;
        }
       }
    }
}
