class Solution {
    // Please change the array in-place
    public void insertionSort(int arr[]) {
       int n=arr.length;
       for(int i=1;i<n;i++){
           int ele=arr[i];
           int j=i-1;
           while(j>=0 && arr[j]>ele){
               arr[j+1]=arr[j];
               j=j-1;
           }
           arr[j+1]=ele;
       }
       
        
    }
}
