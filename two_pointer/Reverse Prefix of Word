class Solution {
    public String reversePrefix(String word, char ch) {
        int n=word.length();
        StringBuilder sb=new StringBuilder(word);
        
        for(int i=0;i<n;i++){
            
            if(word.charAt(i)==ch){
                reverse(0,i,sb);
                break;
            }
        }
        return sb.toString();
    }
    public void reverse(int i,int j,StringBuilder sb){
        while(i<j){
            char temp=sb.charAt(i);
            sb.setCharAt(i,sb.charAt(j));
             sb.setCharAt(j,temp);
             i++;
             j--;
        }
    }
}
