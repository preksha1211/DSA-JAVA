class Solution {
    public int[] pivotArray(int[] nums, int pivot) {
        int n=nums.length;
        int l=0;
      
        int e=0;
        for(int i=0;i<n;i++){
             if(nums[i]<pivot){
                l++;
             }
             else if(nums[i]==pivot){
                e++;
            }
        }
        int ll=0;
        int ee=l;
        int g=l+e;
        int[] ans=new int[n];
        for(int i=0;i<n;i++){
             if(nums[i]<pivot){
                ans[ll]=nums[i];
                ll++;
             }
             else if(nums[i]==pivot){
                ans[ee]=nums[i];
                ee++;
            }
            else{
                ans[g]=nums[i];
                g++;
                
            }
        }
        return ans;
        
    }
}
