class Solution {
    public int[] sortArrayByParityII(int[] nums) {
        int i=0;
        int j=1;
        int n=nums.length;
        
        while(i<n && j<n ){
            if(nums[i]%2==0 ){
                
                i=i+2;
            }
            else if(nums[j]%2!=0){
                
                j=j+2;
            }
            else{
                swap(i,j,nums);
                i=i+2;
                j=j+2;
            }
        }
        return nums;
    }
    public void swap(int i,int j,int[] nums){
        int temp=nums[i];
        nums[i]=nums[j];
        nums[j]=temp;
    }
}
