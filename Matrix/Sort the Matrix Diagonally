class Solution {
    public int[][] diagonalSort(int[][] mat) {
        HashMap<Integer,List<Integer>> map=new HashMap<>();
        int n=mat.length;
        int m=mat[0].length;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                int idx=i-j;
                map.putIfAbsent(idx,new ArrayList<>());
                map.get(idx).add(mat[i][j]);
            }
        }
       for (List<Integer> it : map.values()) {
            Collections.sort(it);
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                int idx=i-j;
                mat[i][j]=map.get(idx).get(0);
                List<Integer> ll=map.get(idx);
                ll.remove(0);
            }
        }
        return mat;
    }
}
