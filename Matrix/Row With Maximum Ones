class Solution {
    public int[] rowAndMaximumOnes(int[][] mat) {
        int ans=0;
        int maxi=0;
        int n=mat.length;
        int m=mat[0].length;
        for(int i=0;i<n;i++){
            int ones=0;
            for(int j=0;j<m;j++ ){
                if(mat[i][j]==1){
                    ones++;
                }
            }
            if(ones>maxi){
                maxi=ones;
                ans=i;

            }
        }
        return new int[]{ans,maxi};
        
    }
}
