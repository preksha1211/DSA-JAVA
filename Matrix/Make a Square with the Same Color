class Solution {
    public boolean canMakeSquare(char[][] grid) {
        int n=grid.length;
        for(int i=0;i<n-1;i++){
            
            for(int j=0;j<n-1;j++){
                int w=0;
                int b=0;
                int[] row={0,1,1,0};
                int[] col={1,0,1,0};
                for(int k=0;k<4;k++){
                    int r=i+row[k];
                    int c=j+col[k];
                    if(grid[r][c]=='W'){
                    w++;
                    }
                    else{
                        b++;
                    }
                }
                
                if(w>=3 || b>=3){
                    return true;
                }
            }
            
        }
        return false;
    }
}
