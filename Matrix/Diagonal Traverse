class Solution {
    public int[] findDiagonalOrder(int[][] mat) {
        int n=mat.length;
        int m=mat[0].length;
        int[] ans=new int[n*m];
        HashMap<Integer,List<Integer>> map = new HashMap<>();
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                int no=i+j;
                if(map.containsKey(no)){
                    map.get(no).add(mat[i][j]);
                }
                else{
                    List<Integer> ll=new ArrayList<>();
                    ll.add(mat[i][j]);
                    map.put(no,ll);
                }
            }
        }
        
        int k=0;
        boolean f=true;
        for(List<Integer> ll : map.values()){
            if(f){
               
                for(int i=ll.size()-1;i>=0;i--){
                    ans[k++]=ll.get(i);
                }
                f=false;
              

            }
            else{
                
                 for(int i=0;i<ll.size();i++){
                    ans[k++]=ll.get(i);
                }
                f=true;
           
            }

        }
        return ans;
    }
}
