class Solution {
    public int maxIncreaseKeepingSkyline(int[][] grid) {
        int n=grid.length;
        int[] rowMax = new int[n];
        int[] colMax = new int[n];
        for(int i=0;i<n;i++){
            int maxi=-1;
            for(int j=0;j<n;j++){
                maxi=Math.max(maxi,grid[i][j]);
            }
            rowMax[i]=maxi;
        }

         for(int j=0;j<n;j++){
            int maxi=-1;
            for(int i=0;i<n;i++){
                maxi=Math.max(maxi,grid[i][j]);
            }
            colMax[j]=maxi;
        }
        int sum=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                int mini = Math.min(rowMax[i],colMax[j]);
                int diff=mini-grid[i][j];
                sum+=diff;
                
            }
        }
        return sum;

    }
}
