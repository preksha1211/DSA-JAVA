class Solution {
    public boolean isValidSudoku(char[][] board) {
        int n=board.length;
       
        for(int i=0;i<n;i++){
            HashSet<Character> set=new HashSet<>();
            for(int j=0;j<n;j++){
                char ele=board[i][j];
                if(ele=='.'){
                   continue;
                }
                if(set.contains(ele)){
                    return false;
                }
                set.add(ele);

            }
        }

        for(int j=0;j<n;j++){
            HashSet<Character> set=new HashSet<>();
            for(int i=0;i<n;i++){
                char ele=board[i][j];
                if(ele=='.'){
                   continue;
                }
                if(set.contains(ele)){
                    return false;
                }
                set.add(ele);

            }
        }
        
        for(int i=0;i<n;i+=3){
           
            for(int j=0;j<n;j+=3){
               
                
                HashSet<Character> set=new HashSet<>();
                for(int k=i;k<i+3;k++){
                    for(int l=j;l<j+3;l++){
                        char ele=board[k][l];
                        if(ele=='.'){
                            continue;
                            }
                        if(set.contains(ele)){
                            return false;
                        }
                        set.add(ele);
                    }
                }

            }
        }
        return true;
        
    }
}
