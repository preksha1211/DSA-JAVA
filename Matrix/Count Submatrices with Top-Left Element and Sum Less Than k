class Solution {
    public int countSubmatrices(int[][] grid, int k) {
        int n=grid.length;
        int m=grid[0].length;
        int[][] sum=new int[n][m];
        int ans=0;
        sum[0][0]=grid[0][0];
        if(sum[0][0]<=k) ans++;

        for(int i=1;i<m;i++){
            sum[0][i]=sum[0][i-1]+grid[0][i];
            if(sum[0][i]<=k){
                ans++;
            }
        }

        for(int i=1;i<n;i++){
            sum[i][0]=sum[i-1][0]+grid[i][0];
            if(sum[i][0]<=k){
                ans++;
            }
        }

        for(int i=1;i<n;i++){
            for(int j=1;j<m;j++){
                sum[i][j]=sum[i-1][j]+sum[i][j-1]+grid[i][j]-sum[i-1][j-1];
                if(sum[i][j]<=k){
                  ans++;
                }
            }
        }
      
        
            return ans;
        
    }
}
