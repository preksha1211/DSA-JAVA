class Solution {
    public int[][] restoreMatrix(int[] rowSum, int[] colSum) {
         int rlen=rowSum.length;
         int clen=colSum.length;
         int[][] ans=new int[rlen][clen];
         for(int i=0;i<rlen;i++){
            for(int j=0;j<clen;j++){
                int ele=Math.min(rowSum[i],colSum[j]);
                ans[i][j]=ele;
                rowSum[i]=rowSum[i]-ele;
                colSum[j]=colSum[j]-ele;
            }
         }
         return ans;

    }
}
