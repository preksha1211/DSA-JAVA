class Solution {
    public void bubbleSort(int[] arr) {
          
        int n=arr.length;
        for(int i=0;i<n-1;i++){
            int min_idx=i;
            int mini=arr[i];
            for(int j=i+1;j<n;j++){
                if(arr[j]<mini){
                    mini=arr[j];
                    min_idx=j;
                } 
            }
            int temp=arr[i];
            arr[i]=arr[min_idx];
            arr[min_idx]=temp;
           
        }
        
    }
}
