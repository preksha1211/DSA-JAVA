class Solution {
    public void bubbleSort(int[] arr) {
          
       int n=arr.length;
       for(int i=0;i<n-1;i++){
           for(int j=0;i<n-j-1;j++){
               if(arr[j] >arr[j+1]){
                   swap(j+1,j,arr);
               }
           }
       }
    }
    public void swap(int i,int j,int[] arr){
        int temp=arr[j];
        arr[j]=arr[i];
        arr[i]=temp;
    }
}
