class Solution {
    public int minPathSum(int[][] grid) {
        int n = grid.length;
        int m = grid[0].length;
        int[][] dp=new int[n][m];
        dp[0][0]=grid[0][0];
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if (i == 0 && j == 0) {
                    continue;
                }
            
                int u=90000000;
                if(i>0){
                    u=grid[i][j]+dp[i-1][j];
                }
                int l=90000000;
                if(j>0){
                    l=grid[i][j]+dp[i][j-1];
                }
                
                dp[i][j]= Math.min(u, l);
            }
                    
        }
        return dp[n-1][m-1];
    }

   
}
