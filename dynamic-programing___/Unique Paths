recursive solution

class Solution {
    public int uniquePaths(int m, int n) {
        return f(n-1,m-1);
    }
    public int f(int i,int j){
        if(i==0 && j==0){
            return 1;
        }
        if(i<0 || j<0){
            return 0;
        }
        int u=f(i-1,j);
        int l=f(i,j-1);
        return u+l;
        
    }
}
