//tabulation or bottom up solution
class Solution {
    public int uniquePaths(int m, int n) {
        int[][] dp=new int[n][m];

        dp[0][0]=1;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(i==0 && j==0){
                    continue;
                }
                int u=0;
                if(i>0){
                   u=dp[i-1][j];
                }
                int l=0;
                if(j>0){
                    l=dp[i][j-1];
                }
                dp[i][j]=u+l;
            }
        }
        return dp[n-1][m-1];
    }
    
}
