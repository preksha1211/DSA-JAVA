//memoization solution
class Solution {
    public int uniquePaths(int m, int n) {
        int[][] dp=new int[n+1][m+1];
        for(int[] a:dp){
            Arrays.fill(a,-1);
        }
        return f(n-1,m-1,dp);
    }
    public int f(int i,int j,int[][] dp){
        if(i==0 && j==0){
            return 1;
        }
        if(i<0 || j<0){
            return 0;
        }
        if(dp[i][j]!=-1){
            return dp[i][j];
        }
        int u=f(i-1,j,dp);
        int l=f(i,j-1,dp);
        return dp[i][j]=u+l;
        
    }
}
