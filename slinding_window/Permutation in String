class Solution {
    public boolean checkInclusion(String s1, String s2) {
        
        int n=s2.length();
        int ws=s1.length();
        int l=0;
        int r=0;
        int[] freqp=new int[26];
        for(int i=0;i<s1.length();i++){
            char ch=s1.charAt(i);
            freqp[ch-'a']++;
        }
        int[] freq=new int[26];
        while(r<n){
            freq[s2.charAt(r)-'a']++;
            if(r-l+1==ws){
                if(check(freq,freqp)){
                    return true;
                }
                freq[s2.charAt(l)-'a']--;
                l++;
            }
            r++;
        }
        return false;
    }
    public boolean check(int[] freq,int[] freqp){
        for(int i=0;i<26;i++){
            if(freq[i]!=freqp[i]){
                return false;
            }
        }
        return true;
    }
}
