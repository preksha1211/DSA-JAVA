class Solution {
    public int[] getSubarrayBeauty(int[] nums, int k, int x) {
        int[] freq=new int[101];
        int l=0;
        int n=nums.length;
        int r=0;
        int no=n-k+1;
        int[] ans=new int[no];
        int idx=0;
        while(r<n){
            freq[nums[r]+50]++;
            while(r-l+1==k){
                ans[idx++]=find(freq,x);
                freq[nums[l]+50]--;
                l++;
            }
            r++;
        }
        return ans;
    }
    public int find(int[] freq,int x){
        int nth=0;
        for(int i=0;i<101;i++){
               nth+=freq[i];
               if(nth>=x){
                  if(i-50>=0){
                     return 0;
                  }
                  else{
                    return i-50;
                  }
               }
        }
        return -1;
    }
}
