class Solution {
    public int characterReplacement(String s, int k) {
        int n=s.length();
        int l=0;
        int r=0;
        HashMap<Character,Integer> map=new HashMap<>();
        int maxLen=0;
        int maxfreq=0;
        while(r<n){
            char ch=s.charAt(r);
            map.put(ch,map.getOrDefault(ch,0)+1);
            maxfreq=Math.max(maxfreq,map.get(ch));
            if(r-l+1-maxfreq>k){
                char cc=s.charAt(l);
                int ff=map.get(cc);
                ff=ff-1;
                if(ff==0){
                    map.remove(cc);
                }
                else{
                    map.put(cc,ff);
                }
                l++;
            }
            maxLen=Math.max(maxLen,r-l+1);
            r++;
            
            
        }
        return maxLen;
    }
}
