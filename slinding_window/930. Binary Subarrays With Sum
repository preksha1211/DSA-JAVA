class Solution {
    public int numSubarraysWithSum(int[] nums, int goal) {
        return f(goal,nums)-f(goal-1,nums);
    }
    public int f(int goal,int[] nums){
        if(goal<0){
            return 0;
            }
        int n=nums.length;
        int l=0;int r=0;
        int sum=0;
        int cnt=0;
        while(r<n){
            
            sum+=nums[r];
            
                while(sum>goal){
                    sum-=nums[l];
                    l++;
                }
                cnt=cnt+(r-l+1);
                r++;
            
            
        }
        return cnt;
    }
}
